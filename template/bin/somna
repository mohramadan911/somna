TTY = sys.stdout.isatty()


def col(s, code):
    return "\033[{}m{}\033[0m".format(code, s) if TTY else s


class SomnaError(Exception):
    """A clean, user-facing failure. code lets the UI react (e.g. 'concurrency')."""

    def __init__(self, msg, code="error", etype=None):
        super().__init__(msg)
        self.code = code
        self.etype = etype


class CycleCanceled(SomnaError):
    """Raised inside a run when its cancel was requested."""

    def __init__(self, msg="canceled"):
        super().__init__(msg, "canceled", "canceled")


def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    return dt.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)


# ---------------- logging ----------------
LEVELS = {"debug": 10, "info": 20, "warn": 30, "error": 40}
ACTOR = os.environ.get("SOMNA_ACTOR", "cli")
_log_lock = threading.Lock()
_file_lock = threading.Lock()   # usage.json and events.jsonl are shared by parallel runs
_current_cycle = threading.local()


def _rotate(p, max_bytes=5 * 1024 * 1024, keep=3):
    try:
        if p.exists() and p.stat().st_size > max_bytes:
            for i in range(keep - 1, 0, -1):
                src = p.with_name("{}.{}".format(p.name, i))
                if src.exists():
                    src.replace(p.with_name("{}.{}".format(p.name, i + 1)))
            p.replace(p.with_name(p.name + ".1"))
    except OSError:
        pass


def log(level, event, msg="", **fields):
    """Write one event to logs/somna.jsonl, logs/somna.log and the cycle's run.log. Never raises."""
    try:
        did = fields.pop("cycle", None) or getattr(_current_cycle, "id", None)
        rec = {"ts": utcnow().strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z", "level": level, "event": event,
               "msg": msg, "actor": ACTOR, "pid": os.getpid()}
        if did:
            rec["cycle"] = did
        if fields:
            rec["data"] = fields
        line = json.dumps(rec, default=str)
        human = "{} {:<5} {:<22} {}{}{}".format(rec["ts"], level.upper(), event, msg,
                                              " [{}]".format(did) if did else "",
                                              " " + json.dumps(fields, default=str) if fields else "")
        with _log_lock:
            LOGS.mkdir(parents=True, exist_ok=True)
            for name, text in (("somna.jsonl", line), ("somna.log", human)):
                p = LOGS / name
                _rotate(p)
                with open(str(p), "a", encoding="utf-8") as fh:
                    fh.write(text + "\n")
            if did and (CYCLES / did).exists():
                with open(str(CYCLES / did / "run.log"), "a", encoding="utf-8") as fh:
                    fh.write(human + "\n")
    except Exception:
        pass


def git(*args, cwd=None, check=True):
    r = subprocess.run(["git", *args], cwd=str(cwd or HOME), capture_output=True, text=True)
    if check and r.returncode != 0:
        err = (r.stderr or r.stdout).strip()
        log("error", "git.failed", "git {} failed".format(args[0]), args=list(args), cwd=str(cwd or HOME), stderr=err[-600:])
        raise SomnaError("git {} failed: {}".format(" ".join(args), err))
    return r.stdout.strip()


def dirty_paths(*pathspec, cwd=None):
    """Uncommitted paths (modified, staged or untracked). Parsed from -z output, never stripped."""
    r = subprocess.run(["git", "status", "--porcelain", "-z", "--untracked-files=all", "--", *pathspec],
                       cwd=str(cwd or HOME), capture_output=True, text=True)
    out, parts, i = [], r.stdout.split("\0"), 0
    while i < len(parts):
        e = parts[i]
        if len(e) > 3:
            out.append(e[3:])
            if e[0] in "RC":
                i += 1
        i += 1
    return out


def is_log_path(p):
    return any(p.startswith(x) for x in LOG_PREFIXES)


