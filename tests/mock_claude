#!/usr/bin/env python3
"""Stand-in for the Claude Code CLI. Behaves like a cycle or map run, can misbehave on request."""
import json, os, pathlib, re, sys, time

a = sys.argv[1:]
if a[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "claude.ai"})); sys.exit(0)
if "-p" in a and a[a.index("-p") + 1] == "Reply with exactly the word OK.":
    m = a[a.index("--model") + 1] if "--model" in a else "claude-opus-5-5"
    assert a[a.index("--tools") + 1] == "" and "--max-turns" in a
    if m in os.environ.get("MOCK_BADMODELS", "").split(","):
        print(json.dumps({"type": "result", "is_error": True, "result": "There's an issue with the selected model"})); sys.exit(1)
    print(json.dumps({"type": "result", "is_error": False, "result": "OK", "modelUsage": {m if m not in ("opus", "sonnet") else "claude-" + m + "-5-5": {}}}))
    sys.exit(0)
STREAM = a[a.index("--output-format") + 1] == "stream-json"
if STREAM:
    assert "--verbose" in a, "stream-json needs --verbose"
MODEL = a[a.index("--model") + 1] if "--model" in a else "default"
_n = [0]


def emit(o):
    print(json.dumps(o), flush=True)


def step(tool=None, inp=None, text=None):
    _n[0] += 1
    content = []
    if text:
        content.append({"type": "text", "text": text})
    if tool:
        content.append({"type": "tool_use", "id": "t%d" % _n[0], "name": tool, "input": inp or {}})
    if STREAM:
        emit({"type": "assistant", "message": {"id": "msg_%d" % _n[0], "content": content,
              "usage": {"input_tokens": 1000, "output_tokens": 50, "cache_read_input_tokens": 200}}})
        if os.environ.get("MOCK_STEP_DELAY"):
            time.sleep(float(os.environ["MOCK_STEP_DELAY"]))


def finish(result, cost, turns, is_error=False):
    o = {"type": "result", "subtype": "error_during_execution" if is_error else "success", "is_error": is_error,
         "result": result, "total_cost_usd": cost, "num_turns": turns,
         "usage": {"input_tokens": 1000 * _n[0], "output_tokens": 50 * _n[0]}}
    emit(o)


if STREAM:
    emit({"type": "system", "subtype": "init", "model": MODEL})
for flag in ("-p", "--output-format", "--permission-mode", "--allowedTools", "--tools", "--no-session-persistence"):
    assert flag in a, "missing flag " + flag
prompt = a[a.index("-p") + 1]
mode = os.environ.get("MOCK_MODE", "change")
log = pathlib.Path(os.environ["HOME"]) / "mock-calls.log"
with open(log, "a") as fh:
    fh.write(json.dumps({"max_turns": a[a.index("--max-turns") + 1] if "--max-turns" in a else None, "budget": a[a.index("--max-budget-usd") + 1] if "--max-budget-usd" in a else None, "cwd": os.getcwd(), "tools": a[a.index("--tools") + 1], "perm": a[a.index("--permission-mode") + 1],
                         "dirs": [a[i + 1] for i, x in enumerate(a) if x == "--add-dir"], "kind": "map" if prompt.startswith("MAP REPO") else prompt.split("\n", 1)[0].lower() if prompt.startswith(("HUNT", "VALIDATE", "VERIFY", "ASK", "AUDIT")) else "cycle", "model": MODEL,
                         "instructions": re.search(r"<instructions>\n(.*?)\n</instructions>", prompt, re.S).group(1) if "<instructions>" in prompt else None}) + "\n")

if os.environ.get("MOCK_SLOW"):
    time.sleep(float(os.environ["MOCK_SLOW"]))

def _rel(pth):
    s = str(pth)
    return "memory/" + s.split("/memory/", 1)[1] if "/memory/" in s else s


def _first_user(sdir):
    for f in sorted(pathlib.Path(sdir).glob("*.md")):
        if f.name.endswith(".full.md"):
            continue
        for line in f.read_text().splitlines():
            if "**user:** " in line:
                return f.stem, line.split("**user:** ", 1)[1].strip()
    return None, None


def reply(obj, cost=0.05):
    step("Read", {"file_path": "x"}, "Reading")
    if os.environ.get("MOCK_HUNT_BADJSON") and isinstance(obj, dict) and "findings" in obj:
        finish("I looked around and found a few things worth noting.", cost, 3)
    else:
        finish(json.dumps(obj), cost, 3)
    sys.exit(0)


if prompt.startswith("ASK"):
    assert a[a.index("--tools") + 1] == "", "Ask Somna must run without tools"
    q = re.search(r"<question>\n(.*?)\n</question>", prompt, re.S).group(1)
    mat = re.search(r"<material>\n(.*)\n</material>", prompt, re.S).group(1)
    with open(pathlib.Path(os.environ["HOME"]) / "mock-ask.log", "a") as fh:
        fh.write(json.dumps({"q": q, "material": mat}) + "\n")
    out = {"answer": "", "cites": [], "actions": []}
    ql = q.lower()
    files = re.findall(r"^### (memory/\S+)$", mat, re.M)
    if "cheaper" in ql:
        out["answer"] = "Use a cheaper model for the checks."
        out["actions"].append({"type": "settings", "settings": {"check_model": "haiku"}, "why": "the checks only read and compare"})
    if "nonsense setting" in ql:
        out["actions"].append({"type": "settings", "settings": {"turbo_mode": True}})
    if "jenkins" in ql:
        for fpath in files:
            sec = mat.split("### " + fpath + "\n", 1)[1].split("\n### ", 1)[0]
            line = next((l for l in sec.splitlines() if "Jenkins" in l), None)
            if line:
                out["answer"] = "That line is outdated. Here is the change."
                out["cites"].append(fpath)
                out["actions"].append({"type": "memory", "file": fpath, "action": "replace", "target_text": line,
                                       "new_text": "- Deploys run from GitHub Actions", "summary": "Deploys moved from Jenkins to GitHub Actions."})
                break
    if "note that" in ql and "memory/clients/acme/repos/shop.md" in files:
        out["actions"].append({"type": "memory", "file": "memory/clients/acme/repos/shop.md", "action": "add", "section": "## How it ships",
                               "new_text": "- Releases are tagged on Fridays", "summary": "Releases are tagged on Fridays."})
    if "sneaky" in ql:
        out["actions"].append({"type": "memory", "file": "memory/clients/globex/context.md", "action": "add", "section": "## Notes",
                               "new_text": "- sneaky", "summary": "x"})
    if "run" in ql.split():
        out["actions"].append({"type": "run", "since_hours": 24, "instructions": "Focus on the queue alarms."})
    if "always" in ql:
        out["actions"].append({"type": "steer", "text": "Always keep the decision list as it is.", "standing": True})
    if not out["answer"]:
        out["answer"] = "Here is what I found. Sections: " + ", ".join(re.findall(r"^## (.+)$", mat, re.M)[:30])
    if os.environ.get("MOCK_ASK_PROSE"):
        finish("Just some text, not JSON.", 0.003, 1); sys.exit(0)
    finish(json.dumps(out), 0.004, 1); sys.exit(0)

if prompt.startswith("AUDIT"):
    stage_ = prompt.split("\n", 1)[0].split()
    repo = re.search(r"at (/\S+)\.\n", prompt).group(1)
    if stage_[1] == "RECON":
        assert "Read,Glob,Grep" == a[a.index("--tools") + 1]
        cls = [{"id": "http-auth", "why": "it has an app"}, {"id": "supply-chain", "why": "terraform providers"}]
        if os.environ.get("MOCK_AUDIT_CUSTOM"):
            cls.append({"id": "custom-webhooks", "title": "Webhooks", "what": "unsigned webhook calls", "why": "x"})
        finish(json.dumps({"architecture": "## Components\n- app in envs/web/app.py\n- terraform in main.tf", "attack_classes": cls}), 0.1, 3); sys.exit(0)
    if stage_[1] == "HUNT":
        cls = stage_[2]
        if os.environ.get("MOCK_AUDIT_HUNTFAIL"):
            print("hunter crashed", file=sys.stderr); sys.exit(3)
        fs = []
        if cls == "http-auth":
            fs.append({"id": "h1", "title": "App prints without auth check", "severity": "high", "confidence": "high",
                       "description": "The app runs code with no authentication.", "root_cause": "no auth middleware",
                       "trace": [{"path": "envs/web/app.py", "line": 1, "symbol": "print", "note": "entry"}],
                       "evidence": [{"path": "envs/web/app.py", "line": 1, "quote": "print(1)"}],
                       "conditions": "network access", "remediation": "add an auth check"})
            fs.append({"id": "h2", "title": "Same app issue seen twice", "severity": "medium", "confidence": "medium",
                       "description": "dup", "root_cause": "dup", "trace": [{"path": "envs/web/app.py", "line": 1, "symbol": "print", "note": "entry"}],
                       "evidence": [{"path": "envs/web/app.py", "line": 1, "quote": "print(1)"}], "conditions": "x", "remediation": "x"})
        if cls == "supply-chain":
            fs.append({"id": "s1", "title": "Provider not pinned", "severity": "medium", "confidence": "high",
                       "description": "The provider version is not pinned.", "root_cause": "no version constraint",
                       "trace": [{"path": "main.tf", "line": 1, "symbol": "resource", "note": "the resource"}],
                       "evidence": [{"path": "main.tf", "line": 1, "quote": 'resource "x" "y" {}'}],
                       "conditions": "a malicious provider release", "remediation": "pin the provider"})
            fs.append({"id": "s2", "title": "Made up file", "severity": "low", "confidence": "low", "description": "x", "root_cause": "x",
                       "trace": [], "evidence": [{"path": "nope/missing.tf", "line": 3, "quote": "x"}], "conditions": "x", "remediation": "x"})
            if os.environ.get("MOCK_AUDIT_BADLINE"):
                fs.append({"id": "s3", "title": "Line past the end", "severity": "low", "confidence": "low", "description": "x", "root_cause": "x",
                           "trace": [], "evidence": [{"path": "main.tf", "line": 40, "quote": "resource"}], "conditions": "x", "remediation": "x"})
            if os.environ.get("MOCK_AUDIT_ESCAPE"):
                fs.append({"id": "s4", "title": "Escape", "severity": "low", "confidence": "low", "description": "x", "root_cause": "x",
                           "trace": [], "evidence": [{"path": "../../../../etc/hostname", "line": 1, "quote": "a"}], "conditions": "x", "remediation": "x"})
        finish(json.dumps({"findings": fs}), 0.2, 5); sys.exit(0)
    if stage_[1] == "VALIDATE":
        fpath = re.search(r"Try to DISPROVE each finding in (\S+)\. ", prompt).group(1)
        fs = json.loads(pathlib.Path(fpath).read_text())["findings"]
        vs = []
        for f in fs:
            v = {"id": f["id"], "verdict": "upheld", "reason": "nothing stops it", "path": f["evidence"][0]["path"], "line": f["evidence"][0]["line"], "quote": f["evidence"][0]["quote"]}
            if os.environ.get("MOCK_AUDIT_REFUTE") and "Provider" in f["title"]:
                v.update(verdict="refuted", reason="the lock file pins it", path="main.tf", line=1, quote='resource "x" "y" {}')
            vs.append(v)
        finish(json.dumps({"verdicts": vs}), 0.05, 2); sys.exit(0)
    if stage_[1] == "VERIFY":
        ipath = re.search(r"For each item in (\S+), ", prompt).group(1)
        items = json.loads(pathlib.Path(ipath).read_text())["items"]
        assert all(not ({"description", "root_cause", "confidence", "severity", "remediation"} & set(i)) for i in items), "fresh check saw reasoning"
        cs = []
        for i in items:
            v = "confirmed"
            if os.environ.get("MOCK_AUDIT_UNSURE") and "auth" in i["title"]:
                v = "needs_validation"
            cs.append({"id": i["id"], "verdict": v, "reason": "the code shows it"})
        finish(json.dumps({"checks": cs}), 0.05, 2); sys.exit(0)

if prompt.startswith("HUNT"):
    if mode == "fail" or (os.environ.get("MOCK_HUNT_FAIL") and os.environ["MOCK_HUNT_FAIL"] in prompt.split("\n", 1)[0]):
        print("hunter crashed", file=sys.stderr); sys.exit(3)
    cls = prompt.split("\n", 1)[0].split()[1]
    group = re.search(r"\(group id: (\S+)\)", prompt).group(1)
    sdir = re.search(r"Session digests, one file per session: (\S+)", prompt).group(1)
    mem = pathlib.Path(re.search(r"Memory \(read it first, to know what is already there\): (\S+)", prompt).group(1))
    sid, quote = _first_user(sdir)
    out = []
    if mode == "nochange":
        reply({"findings": []})
    pairs = re.findall(r"context `([^`]+)`, inbox `([^`]+)`", prompt)
    if cls in ("new", "all"):
        if group == "general":
            gf = mem / "work" / "releases.md"
            out.append({"id": "g1", "action": "add", "file": "memory/work/releases.md", "section": "## Lessons learned",
                        "new_text": "- General lesson {}".format(int(time.time() * 1000)),
                        "summary": "A lesson from today's work goes into your release notes.",
                        "evidence": [{"source": "session:" + sid, "quote": quote}], "refs": [], "confidence": "high"})
        for ctx, inbox in pairs:
            i = pathlib.Path(inbox)
            notes = [l for l in (i.read_text().splitlines() if i.exists() else []) if l.startswith("- ")]
            for n, line in enumerate(notes or ["- {}".format(quote)]):
                text = re.sub(r"^- \d{4}-\d{2}-\d{2}: ", "- ", line)
                ev = [{"source": "session:" + sid, "quote": quote}]
                if notes:
                    ev.append({"source": "memory:" + _rel(inbox), "quote": line})
                out.append({"id": "n{}".format(len(out) + 1), "action": "add", "file": _rel(ctx), "section": "## Current state",
                            "new_text": text if notes else ("- cycle {} update".format(group) if os.environ.get("MOCK_HUNT_FIXED") else "- cycle {} update from {}".format(group, sid)),
                            "summary": "Your latest work on this repo is now in its context.", "evidence": ev, "refs": [],
                            "confidence": "high"})
        held_file = _rel(pairs[0][0]) if pairs else "memory/work/releases.md"
        out.append({"id": "q1", "action": "add", "file": held_file, "section": "## Current state" if pairs else "## Lessons learned",
                    "new_text": "- Moving to Terragrunt is being discussed", "summary": "Terragrunt was mentioned once, so this is only a question.",
                    "evidence": [{"source": "session:" + sid, "quote": quote}], "refs": [], "confidence": "low"})
    if cls in ("tidy", "all"):
        for ctx, inbox in pairs:
            i = pathlib.Path(inbox)
            for line in [l for l in (i.read_text().splitlines() if i.exists() else []) if l.startswith("- ")]:
                out.append({"id": "t{}".format(len(out) + 1), "action": "remove", "file": _rel(inbox), "target_text": line,
                            "summary": "The inbox note was filed into the context, so it is cleared.",
                            "evidence": [{"source": "memory:" + _rel(inbox), "quote": line}], "refs": [], "confidence": "high"})
    if out and os.environ.get("MOCK_HUNT_BADQUOTE"):
        tgt = next((x for x in out if x["action"] == "add"), None)
        if tgt:
            tgt["evidence"] = [{"source": "session:" + str(sid), "quote": "words that were never said"}]
    if out and os.environ.get("MOCK_HUNT_BADREF"):
        out[0]["refs"] = [{"repo": "nope", "path": "infra/missing.tf", "line": 3}]
    if out and os.environ.get("MOCK_HUNT_BADLINE") and pairs:
        root = re.search(r"- \S+ \((/[^)]+)\): context", prompt)
        out[0]["refs"] = [{"repo": pathlib.Path(root.group(1)).name if root else "x", "path": "main.tf", "line": 99}]
    if os.environ.get("MOCK_HUNT_OUTSCOPE") and group == "general":
        out.append({"id": "o1", "action": "add", "file": "memory/clients/acme/context.md", "section": "## Notes",
                    "new_text": "- Acme fact found in a general session", "summary": "This belongs to Acme, so you decide.",
                    "evidence": [{"source": "session:" + sid, "quote": quote}], "refs": [], "confidence": "high"})
    if os.environ.get("MOCK_HUNT_BADSCHEMA") and out:
        out[0]["action"] = "rewrite"
    reply({"findings": out})

if prompt.startswith("VALIDATE"):
    fpath = re.search(r"Findings to check: (\S+)", prompt).group(1)
    fs = json.loads(pathlib.Path(fpath).read_text())["findings"]
    how = os.environ.get("MOCK_VALIDATE", "")
    vs = []
    for k, f in enumerate(fs):
        v = {"id": f["id"], "verdict": "upheld", "reason": "Nothing newer says otherwise.", "quote": f["evidence"][0]["quote"], "source": f["evidence"][0]["source"]}
        if k == 0 and how == "refute":
            v.update(verdict="refuted", reason="A later session says the opposite.")
        if k == 0 and how == "refute_noquote":
            v.update(verdict="refuted", reason="I think this is wrong.", quote="text that is nowhere")
        if how == "unsure":
            v.update(verdict="unsure")
        vs.append(v)
    if how == "missing":
        vs = vs[1:]
    reply({"verdicts": vs}, 0.02)

if prompt.startswith("VERIFY"):
    cpath = re.search(r"Proposed changes: (\S+)", prompt).group(1)
    cs = json.loads(pathlib.Path(cpath).read_text())["changes"]
    assert all("summary" not in c and "confidence" not in c for c in cs), "the verifier must not see the hunter's reasoning"
    how = os.environ.get("MOCK_VERIFY", "")
    out = []
    for k, c in enumerate(cs):
        v = {"id": c["id"], "verdict": "confirm", "reason": "The session says this."}
        if k == 0 and how == "reject":
            v.update(verdict="reject", reason="The source does not say this.")
        if how == "unsure":
            v.update(verdict="unsure", reason="Hard to tell.")
        out.append(v)
    reply({"checks": out}, 0.02)

if prompt.startswith("MAP REPO"):
    if mode == "mapfail":
        print("map crashed", file=sys.stderr); sys.exit(4)
    assert a[a.index("--tools") + 1] == "Read,Glob,Grep", "map must be read-only"
    name = re.search(r"^# (\S+) \(", prompt, re.M).group(1)
    doc = ("# {n} (client)\n## What this repo does\nTerraform for the shop stack.\n## How to navigate it\n- `envs/` one root per account\n"
           "## How it connects\n- deploys to the web account\n## Current state\n- migration wave 2\n## Gotchas and decisions\n- pin aws ~> 5.0\n"
           "## Questions for the owner\n- The README mentions Globex. Is this really a Acme repo?\n").format(n=name)
    step("Read", {"file_path": os.path.join(os.getcwd(), "main.tf")}, "Reading the repo")
    step("Glob", {"pattern": "**/*.tf"})
    finish(doc, 0.31, 9)
    sys.exit(0)

if mode == "fail":
    print("simulated engine crash: auth expired", file=sys.stderr); sys.exit(3)
group = re.search(r"\(group id: (\S+)\)", prompt).group(1)
if mode == "failclient" and group != "general":
    print("client part crashed", file=sys.stderr); sys.exit(5)
report = pathlib.Path(re.search(r"Write a report to (\S+) with", prompt).group(1))
mem = pathlib.Path(re.search(r"Working copy of memory \(you may edit it\): (\S+)", prompt).group(1))
step("Read", {"file_path": str(mem / "index.md")}, "Verifying memory against the sessions")
if os.environ.get("MOCK_IS_ERROR"):
    finish("broken", 0.01, 1, is_error=True); sys.exit(0)
if mode != "nochange":
    if group == "general":
        general_file = mem / "work" / "releases.md"
        step("Edit", {"file_path": str(general_file)})
        general_file.write_text(general_file.read_text().rstrip() + "\n- General lesson {}\n".format(int(time.time() * 1000)))
        if os.environ.get("MOCK_VIOLATE"):
            (mem / "clients" / "acme" / "leak.md").parent.mkdir(parents=True, exist_ok=True)
            (mem / "clients" / "acme" / "leak.md").write_text("general run wrote into a client folder\n")
    else:
        for ctx, inbox in re.findall(r"context `([^`]+)`, inbox `([^`]+)`", prompt):
            c, i = pathlib.Path(ctx), pathlib.Path(inbox)
            notes = [l for l in (i.read_text().splitlines() if i.exists() else []) if l.startswith("- ")]
            base = c.read_text() if c.exists() else "# {}\n## Current state\n".format(c.stem)
            c.parent.mkdir(parents=True, exist_ok=True)
            step("Edit", {"file_path": str(c)}, "Merging inbox lines")
            c.write_text(base.rstrip() + "\n" + "\n".join(notes + ["- cycle {} update".format(group)]) + "\n")
            if i.exists():
                i.write_text("\n".join(l for l in i.read_text().splitlines() if not l.startswith("- ")) + "\n")
        if os.environ.get("MOCK_VIOLATE"):
            p = mem / "me" / "preferences.md"
            p.write_text(p.read_text() + "- leaked client fact from {}\n".format(group))
            (mem / "clients" / "other-client.md").write_text("cross-client leak\n")
    if not os.environ.get("MOCK_TIDY"):
        pathlib.Path("README.md").write_text("tampered\n")
dm = re.search(r"Also write (\S+) as JSON", prompt)
dmode = os.environ.get("MOCK_DECISIONS", "normal")
if dm and dmode != "none" and mode != "nochange":
    decs = []
    if group == "general":
        decs.append({"file": "memory/work/releases.md", "type": "insight", "summary": "general lesson", "confidence": "high",
                     "evidence": ["a1", "b1"], "applied": True})
    else:
        for ctx, inbox in re.findall(r"context `([^`]+)`, inbox `([^`]+)`", prompt):
            rel = "memory/" + ctx.split("/memory/", 1)[1]
            decs.append({"file": rel, "type": "merged", "summary": "inbox merged", "confidence": "high" if dmode != "skipone" else "medium",
                         "evidence": ["a1"], "applied": True})
        if dmode == "skipone":
            decs = decs[1:]
    if dmode == "dates" and group != "general":
        ctxs = re.findall(r"context `([^`]+)`, inbox", prompt)
        cf = "memory/" + ctxs[0].split("/memory/", 1)[1] if ctxs else "memory/clients/%s/context.md" % group
        decs.append({"file": cf, "type": "new", "summary": "compliance items open", "confidence": "low", "evidence": ["fd53301b"],
                     "evidence_dates": ["2026-09-27"], "applied": False, "proposed": "Open: audit log retention"})
        if os.environ.get("MOCK_COMMIT"):
            decs.append({"file": cf, "type": "replaced", "summary": "old commit says state bucket in us-east-1", "confidence": "low",
                         "evidence": [os.environ["MOCK_COMMIT"]], "applied": False, "proposed": "State bucket: us-east-1"})
        decs.append({"file": cf, "type": "new", "summary": "from an old session", "confidence": "low", "evidence": ["old1"],
                     "applied": False, "proposed": "Old session fact"})
        decs.append({"file": cf, "type": "new", "summary": "fresh but unsure", "confidence": "low", "evidence": ["a1"],
                     "applied": False, "proposed": "Maybe Terragrunt soon"})
        decs.append({"file": "memory/work/aws-access.md", "type": "insight", "summary": "general AWS lesson", "confidence": "low",
                     "evidence": ["a1"], "scope": "general", "applied": False, "proposed": "Check aws sts get-caller-identity before each block of work"})
        pathlib.Path(dm.group(1)).write_text(json.dumps({"decisions": decs}))
        decs = None
    held_file = decs[0]["file"] if decs else "memory/work/releases.md"
    if decs is not None: decs.append({"file": held_file, "type": "new", "summary": "maybe moving to Terragrunt", "confidence": "low",
